<UserControl x:Class="WPF.Controls.DashboardCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Margin="0,0,8,8"
             Padding="16"
             Style="{StaticResource FluentUiCardStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       Style="{StaticResource CaptionTextStyle}" />
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       Margin="0,6,0,0"
                       Style="{StaticResource MetricValueTextStyle}" />
        </StackPanel>
    </ui:Card>
</UserControl>
