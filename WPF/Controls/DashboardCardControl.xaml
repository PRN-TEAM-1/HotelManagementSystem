<UserControl x:Class="WPF.Controls.DashboardCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,0,8,8"
            Padding="16"
            MinHeight="92"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource SurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       Margin="0,6,0,0"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
