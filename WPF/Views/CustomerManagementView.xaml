<UserControl x:Class="WPF.Views.CustomerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,12"
                                 Background="{StaticResource WarningSoftBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,12"
                                 Background="{StaticResource SuccessSoftBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SuccessMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>
        </StackPanel>


        <Grid Grid.Row="1">
            <TabControl>
                <TabItem Header="Booking Desk">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.1*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2">
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Margin="0,8">
                                            <materialDesign:PackIcon Kind="AccountPlus"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{StaticResource AccentBrush}"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="Guest Information (Create/Update)"
                                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid Margin="16,0,16,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Full name" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding IdentityCard, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Identity card" />
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Phone" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="2"
                                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Email" />
                                        <TextBox Grid.Row="2"
                                                 Grid.ColumnSpan="3"
                                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Address" />
                                        </Grid>

                                         <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                         <Button Command="{Binding NewCustomerCommand}"
                                                 Style="{StaticResource SecondaryButtonStyle}"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Clear the selected guest and enter a new guest">
                                             <StackPanel Orientation="Horizontal">
                                                 <materialDesign:PackIcon Kind="Eraser" Width="18" Height="18" Margin="0,0,6,0" />
                                                 <TextBlock Text="New / Clear" />
                                             </StackPanel>
                                         </Button>
                                         <Button Command="{Binding CreateCustomerCommand}"
                                                 Style="{StaticResource PrimaryButtonStyle}"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Create guest profile">
                                             <StackPanel Orientation="Horizontal">
                                                 <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,6,0" />
                                                 <TextBlock Text="Create" />
                                             </StackPanel>
                                         </Button>
                                         <Button Command="{Binding UpdateCustomerCommand}"
                                                 Style="{StaticResource SecondaryButtonStyle}"
                                                 ToolTip="Update selected guest profile">
                                             <StackPanel Orientation="Horizontal">
                                                 <materialDesign:PackIcon Kind="AccountEdit" Width="18" Height="18" Margin="0,0,6,0" />
                                                 <TextBlock Text="Update" />
                                             </StackPanel>
                                         </Button>
                                     </StackPanel>
                                    </Grid>
                                </Expander>
                            </materialDesign:Card>

                            <materialDesign:Card Grid.Row="2"
                                                 Padding="16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSearch"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="Customers"
                                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding SearchCustomersCommand}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Margin="8,0,0,0"
                                                ToolTip="Search customers">
                                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" />
                                        </Button>
                                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Search customers"
                                                 materialDesign:TextFieldAssist.HasClearButton="True" />
                                    </DockPanel>

                                     <DataGrid Grid.Row="2"
                                               ItemsSource="{Binding Customers}"
                                               SelectedItem="{Binding SelectedCustomer}"
                                               AutoGenerateColumns="False"
                                               IsReadOnly="True"
                                               CanUserResizeColumns="True"
                                               CanUserReorderColumns="False"
                                               GridLinesVisibility="Horizontal"
                                               HeadersVisibility="Column"
                                               ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                                               Margin="0,8,0,0">
                                         <DataGrid.Columns>
                                             <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="1.4*" MinWidth="130">
                                                 <DataGridTextColumn.ElementStyle>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="VerticalAlignment" Value="Center" />
                                                         <Setter Property="Margin" Value="4,2" />
                                                         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                         <Setter Property="ToolTip" Value="{Binding FullName}" />
                                                     </Style>
                                                 </DataGridTextColumn.ElementStyle>
                                             </DataGridTextColumn>
                                             <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="1.1*" MinWidth="110">
                                                 <DataGridTextColumn.ElementStyle>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="VerticalAlignment" Value="Center" />
                                                         <Setter Property="Margin" Value="4,2" />
                                                         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                         <Setter Property="ToolTip" Value="{Binding PhoneNumber}" />
                                                     </Style>
                                                 </DataGridTextColumn.ElementStyle>
                                             </DataGridTextColumn>
                                             <DataGridTextColumn Header="Identity" Binding="{Binding IdentityCard}" Width="1.3*" MinWidth="130">
                                                 <DataGridTextColumn.ElementStyle>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="VerticalAlignment" Value="Center" />
                                                         <Setter Property="Margin" Value="4,2" />
                                                         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                         <Setter Property="ToolTip" Value="{Binding IdentityCard}" />
                                                     </Style>
                                                 </DataGridTextColumn.ElementStyle>
                                             </DataGridTextColumn>
                                         </DataGrid.Columns>
                                     </DataGrid>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>

                        <materialDesign:Card Grid.Column="2"
                                             Padding="16"
                                             materialDesign:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentPlus"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="Booking"
                                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshRoomsCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Refresh available rooms">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <DatePicker SelectedDate="{Binding CheckInDate}"
                                                materialDesign:HintAssist.Hint="Check-in" />
                                    <DatePicker Grid.Column="2"
                                                SelectedDate="{Binding CheckOutDate}"
                                                materialDesign:HintAssist.Hint="Check-out" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="12"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Customer"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedCustomer.FullName, TargetNullValue=Select a customer}"
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="12"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Room"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedRoom.RoomNumber, TargetNullValue=Select a room}"
                                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding AvailableRooms}"
                                         SelectedItem="{Binding SelectedRoom}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="152"
                                                    MinHeight="84"
                                                    Padding="12"
                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="OfficeBuilding"
                                                                                 Width="18"
                                                                                 Height="18"
                                                                                 Foreground="{StaticResource AccentBrush}"
                                                                                 Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding RoomNumber}"
                                                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RoomTypeName}"
                                                               Margin="0,6,0,0"
                                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Status}"
                                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                               Foreground="{StaticResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Row="4"
                                        Command="{Binding CreateBookingCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0"
                                        ToolTip="Create booking from selected customer and room">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentPlus"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="Book" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <TabItem Header="Room Map">
                    <materialDesign:Card Margin="0,12,0,0"
                                         Padding="16"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding RefreshRoomsCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Refresh room map">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OfficeBuilding"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Available Rooms"
                                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding AvailableRooms}"
                                     SelectedItem="{Binding SelectedRoom}"
                                     Margin="0,12,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180"
                                                Padding="12"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Kind="OfficeBuilding"
                                                                         Width="24"
                                                                         Height="24"
                                                                         Foreground="{StaticResource AccentBrush}"
                                                                         Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RoomNumber}"
                                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding RoomTypeName}"
                                                           Margin="0,8,0,0"
                                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </materialDesign:Card>
                </TabItem>

                <TabItem Header="Recent Bookings">
                    <materialDesign:Card Margin="0,12,0,0"
                                         Padding="16"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding MarkNoShowCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Mark selected booking as No-Show"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountAlert" Width="18" Height="18" Margin="0,0,6,0" />
                                            <TextBlock Text="Mark No-Show" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelBookingCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            ToolTip="Cancel selected booking">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" Margin="0,0,6,0" />
                                            <TextBlock Text="Cancel Booking" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ReceiptText"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Recent Bookings"
                                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid Grid.Row="1"
                                       ItemsSource="{Binding Bookings}"
                                       SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       Margin="0,12,0,0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Booking" Binding="{Binding BookingId}" Width="Auto" MinWidth="76" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Rooms" Binding="{Binding RoomNumbers}" Width="*" />
                                    <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*" />
                                    <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="92" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding RoomTotal, StringFormat='{}{0:N0} VND'}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </TabItem>

                <TabItem Header="Selected Guest History">
                    <materialDesign:Card Margin="0,12,0,0" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Selected Guest Booking History" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="Guest:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MaterialDesignBody2TextBlock}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding Customers}"
                                              SelectedItem="{Binding SelectedCustomer}"
                                              DisplayMemberPath="FullName"
                                              Width="220"
                                              materialDesign:HintAssist.Hint="Select guest..." />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedCustomerBookings}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Booking ID" Binding="{Binding BookingId}" Width="Auto" MinWidth="80" />
                                    <DataGridTextColumn Header="Guest Name" Binding="{Binding CustomerName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Booked Rooms" Binding="{Binding RoomNumbers}" Width="*" />
                                    <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*" />
                                    <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="92" />
                                    <DataGridTextColumn Header="Total Amount" Binding="{Binding RoomTotal, StringFormat='{}{0:N0} VND'}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </TabItem>
            </TabControl>


            <Border Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="160"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    <TextBlock Text="Loading..."
                               Margin="0,8,0,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
