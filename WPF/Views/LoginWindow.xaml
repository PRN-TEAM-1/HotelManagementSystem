<ui:FluentWindow x:Class="WPF.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hotel Management System - Sign In"
                 Width="1080"
                 Height="680"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource WindowBackgroundBrush}"
                 FontFamily="{StaticResource AppBodyFont}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Hotel Management System"
                     Background="Transparent"
                     ButtonsBackground="{StaticResource SurfaceMutedBrush}"
                     ShowMaximize="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="6">
                        <materialDesign:PackIcon Kind="OfficeBuilding"
                                                 Width="17"
                                                 Height="17"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Hotel Management System"
                               Margin="10,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="34"
                    Background="{StaticResource HeroBrush}"
                    BorderBrush="{StaticResource HeroBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Hotel Management"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   FontSize="34"
                                   Foreground="{StaticResource TextInverseBrush}" />
                        <TextBlock Text="Internal operations workspace"
                                   Margin="0,8,0,0"
                                   FontSize="15"
                                   Foreground="{StaticResource HeroTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="78"
                                Height="78"
                                CornerRadius="8"
                                Background="{StaticResource HeroGlassBrush}"
                                VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="OfficeBuilding"
                                                     Width="40"
                                                     Height="40"
                                                     Foreground="{StaticResource TextInverseBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <TextBlock Text="Front desk, billing, room operations and reports in one focused desktop app."
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Sign in with your staff account to continue."
                                       Margin="0,10,0,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Foreground="{StaticResource HeroTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Designed for hotel staff workflows"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{StaticResource HeroTextSubtleBrush}" />
                </Grid>
            </Border>

            <ui:Card Grid.Column="2"
                     Style="{StaticResource FluentUiCardStyle}"
                     Padding="28"
                     VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sign In"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="26" />
                    <TextBlock Text="Use your staff account to access the workspace."
                               Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextStyle}" />

                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             Margin="0,26,0,8"
                             materialDesign:HintAssist.Hint="Username"
                             materialDesign:TextFieldAssist.HasClearButton="True" />

                    <Grid Margin="0,8,0,8">
                        <PasswordBox x:Name="PasswordBoxInput"
                                     PasswordChanged="OnPasswordChanged"
                                     IsEnabled="{Binding CanEdit}"
                                     materialDesign:HintAssist.Hint="Password"
                                     Padding="10,8,40,8"
                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <TextBox x:Name="VisiblePasswordInput"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnVisiblePasswordChanged"
                                 IsEnabled="{Binding CanEdit}"
                                 materialDesign:HintAssist.Hint="Password"
                                 Padding="10,8,40,8"
                                 Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ToggleButton x:Name="TogglePasswordButton"
                                      IsChecked="{Binding IsPasswordRevealed, Mode=TwoWay}"
                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"
                                      Width="32"
                                      Height="32"
                                      ToolTip="Show or hide password">
                            <ToggleButton.Content>
                                <materialDesign:PackIcon Kind="EyeOff" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}" />
                            </ToggleButton.Content>
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>
                    </Grid>

                    <CheckBox Content="Remember me"
                              IsChecked="{Binding RememberMe, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              Margin="0,4,0,0"
                              ToolTip="Keep this session signed in for 3 days" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,8,0,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               MinHeight="28" />

                    <Button Command="{Binding LoginCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            MinWidth="0"
                            Margin="0,16,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Login"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="Sign in" />
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="Signing in..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
