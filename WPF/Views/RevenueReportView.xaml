<UserControl x:Class="WPF.Views.RevenueReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Language="en-GB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Padding="18,14"
                             Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="From Date" Margin="0,0,0,5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                    <DatePicker SelectedDate="{Binding StartDate}"
                                SelectedDateFormat="Short"
                                materialDesign:HintAssist.Hint="dd/MM/yyyy" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="To Date" Margin="0,0,0,5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                    <DatePicker SelectedDate="{Binding EndDate}"
                                SelectedDateFormat="Short"
                                materialDesign:HintAssist.Hint="dd/MM/yyyy" />
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding FilterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Bottom" Margin="14,0,0,0"
                        ToolTip="Apply the selected date range">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Margin="0,0,7,0" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Command="{Binding ExportCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0"
                        ToolTip="Export report data to CSV">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DownloadOutline" Width="18" Height="18" Margin="0,0,7,0" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="6" Padding="16,10" Width="210"
                        Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="TOTAL REVENUE"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                        <Viewbox Height="28" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Viewbox>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,12"
                Background="#FFF3D6" CornerRadius="8"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                         Foreground="{StaticResource WarningBrush}" />
                <TextBlock Text="{Binding Message}" Margin="8,0,0,0"
                           Foreground="#856404" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Daily Revenue" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Successful payment details for the selected period"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RevenueReports}" Margin="0,12,0,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105" />
                            <DataGridTextColumn Header="Payments" Binding="{Binding PaymentCount}" Width="90" />
                            <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}" Width="145" />
                            <DataGridTextColumn Header="Average" Binding="{Binding AveragePayment, StringFormat='{}{0:N0}'}" Width="115" />
                            <DataGridTextColumn Header="Cash" Binding="{Binding CashRevenue, StringFormat='{}{0:N0}'}" Width="115" />
                            <DataGridTextColumn Header="Bank Transfer" Binding="{Binding BankTransferRevenue, StringFormat='{}{0:N0}'}" Width="125" />
                            <DataGridTextColumn Header="Credit Card" Binding="{Binding CardRevenue, StringFormat='{}{0:N0}'}" Width="115" />
                            <DataGridTextColumn Header="E-Wallet" Binding="{Binding EWalletRevenue, StringFormat='{}{0:N0}'}" Width="115" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Service Revenue Breakdown" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Revenue share by ordered item or service"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Height="224" Margin="0,8,0,6">
                        <Canvas Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="156" Height="156"
                                     Stroke="#E7EEF4" StrokeThickness="33" />
                            <ItemsControl ItemsSource="{Binding ServiceRevenueChart}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding Geometry}" Fill="{Binding Fill}"
                                              Stroke="White" StrokeThickness="3"
                                              SnapsToDevicePixels="True">
                                            <Path.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}" />
                                                    <TextBlock Text="{Binding Percentage, StringFormat='{}{0:P1}'}" />
                                                </StackPanel>
                                            </Path.ToolTip>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Canvas.Left="43" Canvas.Top="59" Width="94">
                                <TextBlock Text="SERVICE TOTAL" HorizontalAlignment="Center" FontSize="9"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Viewbox Height="30" StretchDirection="DownOnly" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DataContext.ServiceRevenueTotal, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0:N0}'}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="VND" HorizontalAlignment="Center" FontSize="9"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Canvas>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServiceRevenueChart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="8,6" CornerRadius="6"
                                            Background="{StaticResource SurfaceMutedBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Fill}"
                                                Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ServiceName}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding QuantityOrdered, StringFormat='{}{0} orders'}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0:P1}'}"
                                                       HorizontalAlignment="Right" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
