<UserControl x:Class="WPF.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Padding="16"
                             Margin="0,0,8,0"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}">
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding RoleDisplay}"
                                   Margin="0,2,0,0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1"
                             Columns="2"
                             Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="State"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SessionState}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Signed in"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LoggedInAtDisplay}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Username"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Username}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Email"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Email}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="3"
                             Columns="2"
                             Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Session ID"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LoginSessionIdDisplay}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="IP"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IpAddress}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Machine"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MachineName}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Margin="12,10,0,0">
                        <TextBlock Text="Windows User"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding WindowsUser}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Device"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DeviceType}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Margin="12,10,0,0">
                        <TextBlock Text="App"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding AppVersion}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1"
                             Padding="16"
                             Margin="8,0,0,0"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Access"
                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding AccessibleAreas}"
                              Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Padding="16"
                             Margin="0,16,0,0"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh session history">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Login and Activity History"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <TabControl Grid.Row="1" Margin="0,12,0,0">
                    <TabItem Header="Login Sessions">
                        <DataGrid ItemsSource="{Binding LoginSessions}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Login" Binding="{Binding LoginAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto" MinWidth="132" />
                                <DataGridTextColumn Header="Logout" Binding="{Binding LogoutAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto" MinWidth="132" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="84" />
                                <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="Auto" MinWidth="120" />
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="Auto" MinWidth="108" />
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceType}" Width="Auto" MinWidth="120" />
                                <DataGridTextColumn Header="OS" Binding="{Binding OsVersion}" Width="*" MinWidth="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Activity Logs">
                        <DataGrid ItemsSource="{Binding ActivityLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto" MinWidth="132" />
                                <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="Auto" MinWidth="140" />
                                <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="Auto" MinWidth="100" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="Auto" MinWidth="80" />
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="Auto" MinWidth="108" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="280" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
