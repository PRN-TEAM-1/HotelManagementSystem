<UserControl x:Class="WPF.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,8"
                                 Background="{StaticResource WarningSoftBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,8"
                                 Background="{StaticResource SuccessSoftBrush}"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SuccessMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding LoadSettingsCommand}"
                                IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Refresh AI settings">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        </Button>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Provider Status"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Settings}"
                              IsEnabled="{Binding CanEdit}"
                              IsReadOnly="True"
                              Margin="0,12,0,0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding ProviderDisplayName}" Width="Auto" MinWidth="92" />
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Key" Binding="{Binding ApiKeyStatus}" Width="Auto" MinWidth="72" />
                            <DataGridTextColumn Header="Active" Binding="{Binding ActiveStatus}" Width="Auto" MinWidth="82" />
                            <DataGridTextColumn Header="Last Test" Binding="{Binding LastTestedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="Auto" MinWidth="132" />
                            <DataGridTextColumn Header="Status" Binding="{Binding LastTestStatus}" Width="1.2*" MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Configure Provider"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding ProviderOptions}"
                                      SelectedItem="{Binding SelectedProviderOption}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanEdit}"
                                      Margin="0,0,0,14"
                                      materialDesign:HintAssist.Hint="Provider" />

                            <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     Margin="0,0,0,14"
                                     materialDesign:HintAssist.Hint="Model name" />

                            <TextBox Text="{Binding ApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="API key" />
                            <TextBlock Text="Leave blank to keep the saved key."
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,0,0,14" />

                            <TextBox Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     Margin="0,0,0,14"
                                     materialDesign:HintAssist.Hint="Endpoint URL" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"
                                         materialDesign:HintAssist.Hint="Temperature" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"
                                         materialDesign:HintAssist.Hint="Timeout seconds" />
                            </Grid>

                            <TextBox Text="{Binding MaxOutputTokensText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     Margin="0,0,0,14"
                                     materialDesign:HintAssist.Hint="Max output tokens" />

                            <CheckBox IsChecked="{Binding IsActive}"
                                      IsEnabled="{Binding CanEdit}"
                                      Content="Use this provider for AI features"
                                      Margin="0,0,0,12" />

                            <Border Background="{StaticResource SurfaceMutedBrush}"
                                    Padding="12"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Selected provider"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedProviderStatus}"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Command="{Binding TestSettingCommand}"
                                IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Test selected provider">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Test" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveSettingCommand}"
                                IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="Save AI provider setting">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Border Grid.ColumnSpan="3"
                    Background="{StaticResource OverlayBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="160"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    <TextBlock Text="Processing..."
                               Margin="0,8,0,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
