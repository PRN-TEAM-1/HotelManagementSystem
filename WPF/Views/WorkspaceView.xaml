<UserControl x:Class="WPF.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Refresh activity dashboard">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartTimelineVariant"
                                             Width="22"
                                             Height="22"
                                             Foreground="{StaticResource AccentBrush}"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="System Activity"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="12"
                            Margin="0,0,0,12"
                            Background="#FFF3D6"
                            CornerRadius="8"
                            Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="#856404"
                                   TextWrapping="Wrap" />
                    </Border>

                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <controls:DashboardCardControl Title="Logins Today"
                                                       Value="{Binding Dashboard.TodayLoginCount}" />
                        <controls:DashboardCardControl Title="Failed Logins"
                                                       Value="{Binding Dashboard.TodayFailedLoginCount}" />
                        <controls:DashboardCardControl Title="Logouts Today"
                                                       Value="{Binding Dashboard.TodayLogoutCount}" />
                        <controls:DashboardCardControl Title="Activities Today"
                                                       Value="{Binding Dashboard.TodayActivityCount}" />
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card Padding="16"
                                             materialDesign:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="7-Day Activity Trend"
                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Dashboard.DailyActivity}"
                                              Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding DateLabel}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ProgressBar Grid.Column="1"
                                                             Height="10"
                                                             Minimum="0"
                                                             Maximum="{Binding DataContext.Dashboard.MaxDailyActivityCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             Value="{Binding ActivityCount}"
                                                             Style="{StaticResource MaterialDesignLinearProgressBar}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ActivityCount}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Column="2"
                                             Padding="16"
                                             materialDesign:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Top Active Accounts"
                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Dashboard.TopActiveUsers}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Margin="0,12,0,0"
                                          HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" MinWidth="110" />
                                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="1.2*" MinWidth="130" />
                                        <DataGridTextColumn Header="Actions" Binding="{Binding ActivityCount}" Width="Auto" MinWidth="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <materialDesign:Card Padding="16"
                                         Margin="0,12,0,0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="320" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Recent System Activity"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Dashboard.RecentActivities}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Margin="0,12,0,0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtLocal, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto" MinWidth="132" />
                                    <DataGridTextColumn Header="Actor" Binding="{Binding ActorUsername}" Width="Auto" MinWidth="110" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="Auto" MinWidth="140" />
                                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="Auto" MinWidth="100" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="Auto" MinWidth="80" />
                                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="Auto" MinWidth="108" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="280" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.RowSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    <TextBlock Text="Loading activity..."
                               Margin="0,8,0,0"
                               Foreground="White"
                               Style="{StaticResource MaterialDesignBody2TextBlock}" />
                </StackPanel>
            </Border>
        </Grid>

        <materialDesign:Card Padding="24"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Workspace"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           FontFamily="{StaticResource AppDisplayFont}"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Use Session to review your current login and recent activity history."
                           Margin="0,8,0,0"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
