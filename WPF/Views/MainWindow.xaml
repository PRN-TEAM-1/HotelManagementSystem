<Window x:Class="WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Hotel Management System"
        Width="1400"
        Height="860"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding AppTitle}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               FontFamily="{StaticResource AppDisplayFont}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextInverseBrush}" />
                    <TextBlock Text="{Binding AppSubtitle}"
                               Margin="0,4,0,0"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="#C2D5E6" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding IsSelected}"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        ToolTip="{Binding Caption}"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{StaticResource TextInverseBrush}"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TitleText}"
                                                   Margin="12,0,0,0"
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextInverseBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <materialDesign:Card Grid.Row="2"
                                     Margin="0,20,0,0"
                                     Padding="16"
                                     Background="#102A40"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="{StaticResource TextInverseBrush}"
                                                     VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding SessionDisplayName}"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextInverseBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SessionRoleDisplay}"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="#A9C4D9" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding AuthenticationState}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="#C2D5E6" />

                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource NavigationButtonStyle}"
                                Margin="0,12,0,0"
                                Padding="10,8"
                                ToolTip="Logout">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="Logout"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource TextInverseBrush}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Logout"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextInverseBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0"
                                 Margin="0"
                                 Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
