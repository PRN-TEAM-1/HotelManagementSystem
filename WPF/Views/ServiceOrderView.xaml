<UserControl x:Class="WPF.Views.ServiceOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,8"
                                 Background="#FFF3D6"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="#856404"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Padding="12"
                                 Margin="0,0,0,8"
                                 Background="#DFF3E7"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{StaticResource SuccessBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SuccessMessage}"
                               Margin="8,0,8,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Command="{Binding ClearMessagesCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Dismiss">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </Grid>
            </materialDesign:Card>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Command="{Binding LoadServicesCommand}"
                                    IsEnabled="{Binding CanEdit}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Refresh services">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                            </Button>
                            <Button Command="{Binding LoadServiceOrdersCommand}"
                                    IsEnabled="{Binding CanEdit}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Refresh orders">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="20" Height="20" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ReceiptText"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Service Orders"
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Padding="12"
                            Margin="0,12,0,0"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Booking Detail"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding BookingDetailId}"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ServiceOrderTotal, StringFormat='{}{0:N0} VND'}"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <DataGrid ItemsSource="{Binding ServiceOrders}"
                                  SelectedItem="{Binding SelectedServiceOrder}"
                                  IsEnabled="{Binding CanEdit}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto" MinWidth="64" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} VND'}" Width="Auto" MinWidth="120" />
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} VND'}" Width="Auto" MinWidth="120" />
                                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="Auto" MinWidth="130" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="92" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="No services yet, add new on the right"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServiceOrders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashPlus"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Add Service"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding ActiveStays}"
                                      SelectedItem="{Binding SelectedStay}"
                                      IsEnabled="{Binding CanEdit}"
                                      Margin="0,0,0,16"
                                      materialDesign:HintAssist.Hint="Select Room / Stay">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="Room " FontWeight="SemiBold"/>
                                            <Run Text="{Binding RoomNumber}" FontWeight="SemiBold"/>
                                            <Run Text=" (Booking #"/>
                                            <Run Text="{Binding BookingId}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <ComboBox ItemsSource="{Binding AvailableServices}"
                                      SelectedItem="{Binding SelectedService}"
                                      DisplayMemberPath="ServiceName"
                                      IsEnabled="{Binding CanEdit}"
                                      Margin="0,0,0,4"
                                      materialDesign:HintAssist.Hint="Service" />
                                      
                            <TextBlock Text="{Binding SelectedService.Price, StringFormat='{}Price: {0:N0} VND'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,0,0,16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"
                                     TextAlignment="Left"
                                     Margin="0,0,0,16"
                                     materialDesign:HintAssist.Hint="Quantity" />

                            <Border Padding="12"
                                    Margin="0,0,0,16"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0">
                                            <Button Command="{Binding SuggestServicesCommand}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="Suggest services with AI">
                                                <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="InformationOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="{StaticResource AccentBrush}"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="AI Suggestions"
                                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBox Text="{Binding GuestPreferenceText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEdit}"
                                             Margin="0,12,0,8"
                                             MinHeight="44"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             materialDesign:HintAssist.Hint="Guest preference" />

                                    <ProgressBar Height="4"
                                                 IsIndeterminate="True"
                                                 Margin="0,0,0,8"
                                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                 Visibility="{Binding IsAiRecommendationBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{Binding AiRecommendationMessage}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding AiRecommendationMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                                    <DataGrid ItemsSource="{Binding AiRecommendations}"
                                              SelectedItem="{Binding SelectedAiRecommendation}"
                                              IsReadOnly="True"
                                              MaxHeight="150"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasAiRecommendations, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" MinWidth="120" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding SuggestedQuantity}" Width="Auto" MinWidth="48" />
                                            <DataGridTextColumn Header="Est." Binding="{Binding EstimatedAmount, StringFormat='{}{0:N0}'}" Width="Auto" MinWidth="80" />
                                            <DataGridTextColumn Header="Fit" Binding="{Binding Confidence, StringFormat='{}{0:P0}'}" Width="Auto" MinWidth="56" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Padding="10"
                                            Margin="0,8,0,0"
                                            Background="White"
                                            CornerRadius="6"
                                            Visibility="{Binding SelectedAiRecommendation, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAiRecommendation.Reason}"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedAiRecommendation.UpsellMessage}"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <Button Command="{Binding UseRecommendationCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,8,0,0"
                                                    ToolTip="Use selected recommendation">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                                    <TextBlock Text="Use" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Command="{Binding CreateServiceOrderCommand}"
                                IsEnabled="{Binding CanEdit}"
                                ToolTipService.ShowOnDisabled="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="ToolTip" Value="Add service order" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="ToolTip" Value="Please select Room, Service and enter Quantity" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelServiceOrderCommand}"
                                IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="Cancel selected service order">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <Border Grid.ColumnSpan="3"
                    Background="#80000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="160"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                    <TextBlock Text="Loading..."
                               Margin="0,8,0,0"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
